new file mode 100644
index 0000000..3f01fee
--- /dev/null
+++ b/harmonia-cache/src/extra_log.rs
@@ -0,0 +1,14 @@
+use actix_web::{HttpResponse, http, web};
+use std::error::Error;
+use std::fs::read_to_string;
+
+use crate::config;
+
+pub(crate) async fn get(config: web::Data<config::Config>) -> Result<HttpResponse, Box<dyn Error>> {
+    match &config.extra_logfile_path {
+        Some(path) => Ok(HttpResponse::Ok()
+            .insert_header(http::header::ContentType::plaintext())
+            .body(read_to_string(path)?)),
+        None => Err("No extra logfile defined in configuration.".into()),
+    }
+}
